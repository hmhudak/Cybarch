@model UniverseIndexVm
@{
    ViewData["Title"] = "Universes";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Universes</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Join">Join universe</a>
        <a class="btn btn-primary" asp-action="Create">Create universe</a>
    </div>
</div>

@if (!Model.Universes.Any())
{
    <div class="alert alert-secondary mt-3">Zatiaľ nie si členom žiadneho Universe.</div>
}
else
{
    <div class="list-group mt-3">
        @foreach (var u in Model.Universes)
        {
            <a class="list-group-item list-group-item-action" asp-action="Details" asp-route-id="@u.Id">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="fw-bold">@u.Name</div>
                        <div class="text-muted small">Ruleset: @u.RulesetKey</div>
                    </div>
                    <div class="text-muted small">#@u.Id</div>
                </div>
            </a>
        }
    </div>
}
