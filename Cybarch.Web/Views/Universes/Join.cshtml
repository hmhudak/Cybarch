@model UniverseJoinVm
@{
    ViewData["Title"] = "Join Universe";
}

<h2>Join Universe</h2>

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="UniverseId" class="form-label"></label>
        <input asp-for="UniverseId" class="form-control" />
        <span asp-validation-for="UniverseId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="JoinPassword" class="form-label"></label>
        <input asp-for="JoinPassword" class="form-control" />
        <span asp-validation-for="JoinPassword" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">Join</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
