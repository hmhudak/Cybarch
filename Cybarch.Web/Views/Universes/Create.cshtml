@model UniverseCreateVm
@{
    ViewData["Title"] = "Create Universe";
}

<h2>Create Universe</h2>

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RulesetKey" class="form-label">Ruleset</label>
        <select asp-for="RulesetKey" class="form-select">
            @foreach (var r in Model.RulesetOptions)
            {
                <option value="@r.Key">@r.Name (@r.Key)</option>
            }
        </select>
        <span asp-validation-for="RulesetKey" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="JoinPassword" class="form-label">Join password (optional)</label>
        <input asp-for="JoinPassword" class="form-control" />
        <div class="form-text">Ak necháš prázdne, vygenerujeme ho automaticky.</div>
    </div>

    <button class="btn btn-primary" type="submit">Create</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
